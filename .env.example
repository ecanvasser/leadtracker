# =============================================================================
# LeadTracker environment
#
# Copy to .env.local for development. Every one of these must also be set in
# Vercel — the app fails closed without them rather than degrading quietly, so
# a missing value shows up as a clear error rather than a silent no-op.
# =============================================================================

# --- Supabase ----------------------------------------------------------------
# Project settings > API. The publishable (anon) key is safe in the browser;
# the service role key is not and is only ever read server-side.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-or-anon-key

# Bypasses row level security. Used by the worker, the Telegram webhook and the
# job handlers, which act on the user's behalf without a session.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- App ---------------------------------------------------------------------
# Public origin. Used to build the Telegram deep link when connecting an
# account; must match the deployed URL or the link will point at localhost.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Bonzo -------------------------------------------------------------------
# Read and write. This token can send SMS and email to real prospects.
BONZO_API_TOKEN=your-bonzo-api-token

# --- Anthropic ---------------------------------------------------------------
ANTHROPIC_API_KEY=sk-ant-...

# Model routing. Defaults are applied when unset; no model string is hardcoded
# in the codebase.
#   analysis — lead-state classification + voice-profile extraction (judgment)
#   draft    — message drafting and redrafts (the high-volume path)
#   extract  — call-time detection, only when a regex/date parse is ambiguous
ANTHROPIC_MODEL_ANALYSIS=claude-opus-5
ANTHROPIC_MODEL_DRAFT=claude-sonnet-5
ANTHROPIC_MODEL_EXTRACT=claude-haiku-4-5

# --- Telegram ----------------------------------------------------------------
# From @BotFather. Rotating this does NOT clear the webhook — the webhook is
# bound to the bot, not the token — but every place holding the old token must
# be updated.
TELEGRAM_BOT_TOKEN=123456:ABC-DEF...

# Sent by Telegram as X-Telegram-Bot-Api-Secret-Token and compared in constant
# time. Separate from the bot token; rotating one does not rotate the other.
TELEGRAM_WEBHOOK_SECRET=long-random-string

# Used to build the t.me deep link on the Settings page.
TELEGRAM_BOT_USERNAME=your_bot
NEXT_PUBLIC_TELEGRAM_BOT_USERNAME=your_bot

# --- Background work ---------------------------------------------------------
# Shared secret between the pg_cron/pg_net tick and /api/worker/drain, so the
# queue drain route is not publicly callable. Must be byte-identical to the
# 'worker_secret' value in Supabase Vault.
#
# A shared secret rather than a JWT on purpose: signing one inside Postgres
# would mean pgjwt (deprecated in PG 17) or pgsodium (Supabase advises against
# new usage).
WORKER_SECRET=long-random-string

# =============================================================================
# Not set here — these live in Supabase, not Vercel
# =============================================================================
#
# Supabase Vault (SQL editor), read by the cron jobs at execution time so no
# URL or token is ever committed:
#   worker_url       your Vercel origin, e.g. https://leadtracker.vercel.app
#   worker_secret    same value as WORKER_SECRET above
#   functions_url    your Supabase origin, e.g. https://xxx.supabase.co
#   reminder_secret  same value as REMINDER_SECRET below
#
# Edge Function secrets (`npx supabase secrets set`), for the call reminder
# dispatcher:
#   REMINDER_SECRET      same value as the reminder_secret vault entry
#   TELEGRAM_BOT_TOKEN   same value as above
#
# See README "Deploying from scratch" for the full order of operations.
