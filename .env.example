# Update these with your Supabase details from your project settings > API
# https://app.supabase.com/project/_/settings/api
NEXT_PUBLIC_SUPABASE_URL=your-project-url
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-or-anon-key

# Shared secret between the pg_cron/pg_net tick and /api/worker/drain, so the
# queue drain route is not publicly callable. Must be byte-identical to the
# 'worker_secret' value stored in Supabase Vault.
WORKER_SECRET=long-random-string

# --- Anthropic -------------------------------------------------------------
ANTHROPIC_API_KEY=sk-ant-...

# Model routing. Defaults are applied when unset; no model string is hardcoded
# in the codebase.
#   analysis — lead-state classification + voice-profile extraction (judgment)
#   draft    — message drafting and redrafts (the high-volume path)
#   extract  — call-time detection, only when a regex/date parse is ambiguous
ANTHROPIC_MODEL_ANALYSIS=claude-opus-5
ANTHROPIC_MODEL_DRAFT=claude-sonnet-5
ANTHROPIC_MODEL_EXTRACT=claude-haiku-4-5
